{
  "uid": "jobforge-runs",
  "title": "JobForge · v3 Runs",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "jobforge",
    "runs",
    "agent-v3"
  ],
  "panels": [
    {
      "id": 1,
      "title": "PG snapshot available",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "jobforge-run-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "jobforge_run_snapshot_success",
          "legendFormat": "{{state}}{{scope}}{{kind}}{{status}}{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "description": "Missing samples are unknown. PG snapshots are durable; process histograms may miss a crash. Known usage is observed, not an invoice. Held exposure is not zero. Account scopes overlap."
    },
    {
      "id": 2,
