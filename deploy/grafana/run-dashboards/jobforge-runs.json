      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (jobforge_run_current)",
          "legendFormat": "{{state}}{{scope}}{{kind}}{{status}}{{result}}"
