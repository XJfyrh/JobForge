FROM golang:1.26.5-bookworm@sha256:53eeac89074db483fdf0ab3be1df32bf6e47562263d2d0d6baa7f26acb4957dd AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY internal/ ./internal/
COPY migrations/ ./migrations/
COPY examples/support-agent/runtime/ ./examples/support-agent/runtime/
COPY cmd/support-business/ ./cmd/support-business/
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/support-business ./cmd/support-business

FROM scratch
COPY --from=build /out/support-business /support-business
USER 65532:65532
ENTRYPOINT ["/support-business"]
CMD ["serve"]
