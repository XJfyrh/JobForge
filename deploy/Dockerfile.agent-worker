FROM golang:1.26.5-bookworm@sha256:53eeac89074db483fdf0ab3be1df32bf6e47562263d2d0d6baa7f26acb4957dd AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/agent-worker ./cmd/agent-worker
COPY internal ./internal
COPY proto ./proto
COPY migrations ./migrations
RUN CGO_ENABLED=0 go build -trimpath -o /out/agent-worker ./cmd/agent-worker

FROM python:3.12.14-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254 AS package
COPY python/pyproject.toml /package/pyproject.toml
COPY python/jobforge_agent /package/jobforge_agent
RUN python -m pip install --no-cache-dir hatchling==1.27.0 && python -m pip wheel --no-deps --no-build-isolation -w /wheels /package

FROM python:3.12.14-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254
COPY --from=package /wheels /wheels
RUN python -m pip install --no-cache-dir httpx==0.28.1 opentelemetry-api==1.44.0 /wheels/*.whl
COPY --from=build /out/agent-worker /usr/local/bin/agent-worker
USER 65532:65532
ENV PYTHONDONTWRITEBYTECODE=1
ENTRYPOINT ["/usr/local/bin/agent-worker"]
