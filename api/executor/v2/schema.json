        "call_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "input_token_limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "output_token_limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
