          "then": {
            "properties": {
              "tool_invocation_id": {
                "const": ""
              }
            }
          },
          "else": {
            "properties": {
              "tool_invocation_id": {
                "$ref": "#/$defs/uuid"
              }
            }
          }
        }
      ]
