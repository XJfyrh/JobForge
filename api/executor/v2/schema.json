        "emitted_mono_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "version",
        "kind",
        "request_id",
        "binding",
        "call_sequence",
        "subcall",
        "parameter_hash",
        "tool_invocation_id",
        "physical_call_id",
        "granted",
        "error_code",
        "dispatch_ms",
        "call_ms",
        "input_token_limit",
        "output_token_limit",
        "emitted_mono_ms"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "granted": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "physical_call_id": {
                "const": ""
              },
              "error_code": {
                "not": {
                  "const": ""
                }
              },
              "dispatch_ms": {
                "const": 0
              },
              "call_ms": {
                "const": 0
              },
              "input_token_limit": {
                "const": 0
              },
              "output_token_limit": {
                "const": 0
              }
            }
          },
          "else": {
            "properties": {
              "physical_call_id": {
                "$ref": "#/$defs/uuid"
              },
              "error_code": {
                "const": ""
              },
              "dispatch_ms": {
                "minimum": 1
              },
              "call_ms": {
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "subcall": {
                "enum": [
                  "get_order",
                  "get_delivery",
                  "profile_version",
                  "profile_tags",
                  "search_policy"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "call_ms": {
                "maximum": 10000
              },
              "input_token_limit": {
                "const": 0
              },
              "output_token_limit": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "subcall": {
                "const": "chat"
              }
            }
