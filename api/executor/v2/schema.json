          ]
        },
        "parameter_hash": {
          "$ref": "#/$defs/sha256"
        },
        "tool_invocation_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "const": ""
            }
          ]
        },
        "physical_call_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "const": ""
            }
          ]
        },
        "granted": {
          "type": "boolean"
        },
        "error_code": {
          "enum": [
            "",
            "BUDGET_EXHAUSTED",
            "STOP_REQUESTED",
            "STALE_LEASE",
            "PROFILE_UNAVAILABLE",
            "DEPENDENCY_UNAVAILABLE",
            "PROTOCOL_ERROR",
