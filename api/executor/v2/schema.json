        },
        "call_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 44
        },
        "subcall": {
          "enum": [
            "get_order",
            "get_delivery",
            "profile_version",
            "profile_tags",
            "query_embedding",
            "search_policy",
            "chat"
          ]
        },
        "parameter_hash": {
          "$ref": "#/$defs/sha256"
        },
        "tool_invocation_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "const": ""
            }
          ]
        },
        "emitted_mono_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "version",
        "kind",
        "request_id",
        "binding",
        "call_sequence",
        "subcall",
        "parameter_hash",
        "tool_invocation_id",
        "emitted_mono_ms"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "subcall": {
                "const": "chat"
              }
            }
          },
          "then": {
            "properties": {
              "tool_invocation_id": {
                "const": ""
              }
            }
          },
          "else": {
            "properties": {
              "tool_invocation_id": {
                "$ref": "#/$defs/uuid"
              }
            }
          }
        }
      ]
    },
    "call_permit": {
      "type": "object",
