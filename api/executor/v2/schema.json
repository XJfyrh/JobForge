            "properties": {
              "transport_outcome": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "http_status": {
                "const": 0
              },
              "business_outcome": {
                "const": "unknown"
              },
              "usage_disposition": {
                "const": "unknown"
              }
            }
          },
          "else": {
