{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobforge.local/support/recovery-v1/profile-schema.json",
  "title": "Confirmed-step recovery support profile definition",
  "description": "Closed ADR0025 schema 3 definition, complete non-null and at most 16384 UTF-8 bytes. Go additionally verifies observed_on >= 2026-09-17, equal model/price observation dates, all cross-field identities and index/price/profile hashes. Recovery requires linux-v2-recovery-runtime-1; artifact digests are checked by trusted preparation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model",
    "price",
    "program",
    "resources",
    "schema_version"
  ],
  "properties": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_tokens",
        "message_content_bytes",
        "model_content_bytes",
        "observed_on",
        "observed_version",
        "origin",
        "path",
        "provider",
        "request_body_bytes",
        "request_model",
        "response_body_bytes",
        "response_format",
        "stream",
        "temperature",
        "thinking"
      ],
      "properties": {
        "max_tokens": {
          "const": 1024
        },
        "message_content_bytes": {
          "const": 65536
        },
        "model_content_bytes": {
          "const": 16384
        },
        "observed_on": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "type": "string",
          "format": "date"
        },
        "observed_version": {
          "const": "DeepSeek-V4.1-Flash"
        },
        "origin": {
          "const": "https://api.deepseek.com"
        },
        "path": {
          "const": "/chat/completions"
        },
        "provider": {
          "const": "deepseek"
        },
        "request_body_bytes": {
          "const": 131072
        },
        "request_model": {
          "const": "deepseek-flash"
        },
        "response_body_bytes": {
          "const": 65536
        },
        "response_format": {
          "const": "json_object"
        },
        "stream": {
          "const": false
        },
        "temperature": {
          "const": 0
        },
        "thinking": {
          "const": "disabled"
        }
      }
    },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "denominator",
        "input_hit_microyuan",
        "input_miss_microyuan",
        "observed_on",
        "output_microyuan",
        "source_sha256"
      ],
      "properties": {
        "currency": {
          "const": "CNY"
        },
        "denominator": {
          "const": 1000000
        },
        "input_hit_microyuan": {
          "const": 40000
        },
        "input_miss_microyuan": {
          "const": 2000000
        },
        "observed_on": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "type": "string",
          "format": "date"
        },
        "output_microyuan": {
          "const": 8000000
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "adapter_source_sha256",
        "prompt_sha256",
        "prompt_version",
        "proposal_schema",
        "proposal_schema_sha256",
        "strategy",
        "decision_schema",
        "decision_schema_sha256",
        "recovery_policy"
      ],
      "properties": {
        "adapter": {
          "const": "support-agent-v1"
        },
        "adapter_source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "prompt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "prompt_version": {
          "const": "support-agent-prompt-v1"
        },
        "proposal_schema": {
          "const": "support-proposal-v1"
        },
        "proposal_schema_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "strategy": {
          "const": "support_agent_v1"
        },
        "decision_schema": {
          "const": "support-agent-decision-v1"
        },
        "decision_schema_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "recovery_policy": {
          "const": "confirmed_uncommitted_v1"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corpus_sha256",
        "dataset_id",
        "index_profile",
        "index_profile_hash",
        "observed_at",
        "policy_version",
        "runtime_manifest_sha256",
        "seed_sha256",
        "tenants"
      ],
      "properties": {
        "corpus_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "dataset_id": {
          "const": "support-dev-2026-09-16-v2"
        },
        "index_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chunker_version",
            "corpus_sha256",
            "dimensions",
            "embedding_digest",
            "embedding_model",
            "policy_version"
          ],
          "properties": {
            "chunker_version": {
              "const": "paragraph-v1"
            },
            "corpus_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "dimensions": {
              "const": 384
            },
            "embedding_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "embedding_model": {
              "const": "all-minilm:22m"
            },
            "policy_version": {
              "const": "delivery-policy-dev-v2"
            }
          }
        },
        "index_profile_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observed_at": {
          "const": "2026-09-16T12:00:00Z"
        },
        "policy_version": {
          "const": "delivery-policy-dev-v2"
        },
        "runtime_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "seed_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tenants": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "index_content_hash",
                "index_id",
                "policy_revision",
                "tenant_id"
              ],
              "properties": {
                "index_content_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "index_id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "policy_revision": {
                  "const": 2
                },
                "tenant_id": {
                  "const": "tenant-north"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "index_content_hash",
                "index_id",
                "policy_revision",
                "tenant_id"
              ],
              "properties": {
                "index_content_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "index_id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "policy_revision": {
                  "const": 2
                },
                "tenant_id": {
                  "const": "tenant-south"
                }
              }
            }
          ],
          "items": false
        }
      }
    },
    "schema_version": {
      "const": 3
    }
  }
}
